<script id="cornerstone-custom-js" type="text/javascript">
const observer = new MutationObserver((mutations, obs) => {
    const icon = document.getElementById('corp-virtual-call-icon');
    const isCorpPage = window.location.pathname.startsWith('/corporations/');

    if (icon && isCorpPage) {
        icon.style.setProperty('display', 'block', 'important');
        obs.disconnect(); // Stop looking once we've hidden it
    }
});

observer.observe(document.documentElement, {
    childList: true,
    subtree: true
});
</script>
