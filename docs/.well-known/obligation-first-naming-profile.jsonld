{
  "@context": "https://obligationfirst.org/v1/context.jsonld",
  "@type": "of:NamingProfile",
  "profileVersion": "2.0.0",
  "appliesTo": "obligation-first >=0.6.0 <0.7.0",
  "adopter": "https://publedge.org/",
  "entities": {
